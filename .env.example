# Learn — local development environment.
#
# Copy to `.env`, adjust what you need, then `docker compose -f infra/docker-compose.yml up`.
# Reserved host ports: backend 8120, frontend 3005, postgres 5437.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:8120
HTTP_ADDR=:8120

# PostgreSQL (matches infra/docker-compose.yml defaults).
DATABASE_URL=postgres://learn:learn@localhost:5437/learn?sslmode=disable

# ---------------------------------------------------------------------------
# Auth
#   dev  — X-Dev-User (identity) + X-Dev-Groups (simulated IdP groups).
#   oidc — Bearer JWT verified via OIDC discovery (set issuer + client id).
# ---------------------------------------------------------------------------
AUTH_MODE=dev
DEV_DEFAULT_USER=dev-admin
DEV_DEFAULT_GROUPS=learn-admin
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
# Access config file (roles & OIDC-group → role bindings). Optional in dev
# (the built-in catalog is used), required for production OIDC deployments.
# ACCESS_CONFIG_PATH=/etc/learn/access-config.toml

# ---------------------------------------------------------------------------
# Branding
#   Standalone: the local brand.json below (or the built-in default).
#   Paired with Den (Settings → Den connection): Den's name, logo and
#   colours override it; the pairing is stored in the database.
# ---------------------------------------------------------------------------
# Optional: path to a server-side brand.json for /api/v1/brand.
BRAND_LOCAL_PATH=
# Optional: replaces the host of the pasted Den pairing URL when this backend
# reaches Den at a different address than the browser does.
DEN_INTERNAL_URL=

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3005,https://den.conservices.test,http://localhost:3001
SHUTDOWN_TIMEOUT=15s
# Extra accepted token audiences (Den's SPA calls Learn directly).
OIDC_EXTRA_AUDIENCES=
# Browser-facing SPA origin used for links in notifications.
PUBLIC_BASE_URL=http://localhost:3005

# ---------------------------------------------------------------------------
# Object storage (S3-compatible; MinIO is LOCAL DEV ONLY). Empty S3_ENDPOINT
# disables uploads. Values match infra/docker-compose.yml (host port 9030).
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9030
S3_BUCKET=learn-data-dev
S3_ACCESS_KEY_ID=learn
S3_SECRET_ACCESS_KEY=learnlearn
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
# Rewrites presigned URLs to a browser-reachable host.
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Email (Learn's own notices). Empty SMTP_HOST disables email.
# Mailpit from infra/docker-compose.yml listens on host port 1026.
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@conservices.local
SMTP_FROM_NAME=Con Services

# ---------------------------------------------------------------------------
# Keycloak Admin API (read-only group lookups). All four set = enabled.
# Suite stack: KEYCLOAK_BASE_URL=http://localhost:8085, realm conservices,
# client learn-provisioner / learn-provisioner-dev-secret.
# ---------------------------------------------------------------------------
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
# Shared secret HR uses to call Learn's internal endpoints.
LEARN_SERVICE_TOKEN=learn-service-dev-token
# Empty = Telegram notifications disabled.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Frontend (rsbuild inlines these at build time; set BEFORE building the image).
# ---------------------------------------------------------------------------
# Leave empty when the SPA is served behind the same origin as /api (nginx).
VITE_API_BASE_URL=http://localhost:8120
VITE_AUTH_MODE=dev
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
VITE_PRODUCT_NAME=Learn
